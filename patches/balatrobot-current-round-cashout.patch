diff --git a/src/lua/endpoints/cash_out.lua b/src/lua/endpoints/cash_out.lua
--- a/src/lua/endpoints/cash_out.lua
+++ b/src/lua/endpoints/cash_out.lua
@@ -24,6 +24,24 @@ return {
   ---@param send_response fun(response: Response.Endpoint)
   execute = function(_, send_response)
     sendDebugMessage("Init cash_out()", "BB.ENDPOINTS")
-    G.FUNCS.cash_out({ config = {} })
-
+
+    -- A prior round's standalone cash-out UIBox can remain in G.I.UIBOX.
+    -- Only the button owned by the active round evaluation is actionable.
+    local cash_out_button = nil
+    for _, box in ipairs(G.I.UIBOX) do
+      if box.config and box.config.major == G.round_eval then
+        cash_out_button = box:get_UIE_by_ID("cash_out_button")
+        if cash_out_button then break end
+      end
+    end
+    if not cash_out_button then
+      send_response({
+        message = "Current round evaluation is not ready to cash out",
+        name = BB_ERROR_NAMES.NOT_ALLOWED,
+      })
+      return
+    end
+
+    G.FUNCS.cash_out(cash_out_button)
+
     local num_items = function(area)
diff --git a/src/lua/endpoints/play.lua b/src/lua/endpoints/play.lua
--- a/src/lua/endpoints/play.lua
+++ b/src/lua/endpoints/play.lua
@@ -136,7 +136,9 @@ return {
           -- Wait for cash_out_button to ensure the last scoring row (bottom) has been processed
           local has_cash_out_button = false
           for _, b in ipairs(G.I.UIBOX) do
-            if b:get_UIE_by_ID("cash_out_button") then
+            if b.config
+              and b.config.major == G.round_eval
+              and b:get_UIE_by_ID("cash_out_button") then
               has_cash_out_button = true
               break
             end
