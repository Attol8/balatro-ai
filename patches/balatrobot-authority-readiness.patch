diff --git a/src/lua/endpoints/checkpoint.lua b/src/lua/endpoints/checkpoint.lua
new file mode 100644
index 0000000..2fbc93a
--- /dev/null
+++ b/src/lua/endpoints/checkpoint.lua
@@ -0,0 +1,79 @@
+-- Bounded in-memory checkpoints for privileged evaluator/search infrastructure.
+
+local RUN_RESTORE = assert(SMODS.load_file("src/lua/utils/run_restore.lua"))()
+local MAX_SNAPSHOTS = 64
+
+BB_CHECKPOINT_STORE = BB_CHECKPOINT_STORE or { entries = {}, count = 0, next_id = 1 }
+BB_CHECKPOINT_CLEAR = function()
+  BB_CHECKPOINT_STORE.entries = {}
+  BB_CHECKPOINT_STORE.count = 0
+end
+
+local function error_response(send_response, message, name)
+  send_response({ message = message, name = name or BB_ERROR_NAMES.BAD_REQUEST })
+end
+
+---@type Endpoint
+return {
+  name = "checkpoint",
+  description = "Create, restore, or delete a private in-memory run checkpoint",
+  schema = {
+    op = { type = "string", required = true, description = "create, restore, delete, or clear" },
+    snapshot_id = { type = "string", required = false, description = "Opaque checkpoint ID" },
+  },
+  requires_state = nil,
+
+  execute = function(args, send_response)
+    if args.op == "clear" then
+      BB_CHECKPOINT_CLEAR()
+      send_response({ success = true })
+      return
+    end
+    if args.op == "delete" then
+      if not BB_CHECKPOINT_STORE.entries[args.snapshot_id] then
+        error_response(send_response, "Unknown checkpoint")
+        return
+      end
+      BB_CHECKPOINT_STORE.entries[args.snapshot_id] = nil
+      BB_CHECKPOINT_STORE.count = BB_CHECKPOINT_STORE.count - 1
+      send_response({ success = true, snapshot_id = args.snapshot_id })
+      return
+    end
+    if args.op == "create" then
+      if G.STAGE ~= G.STAGES.RUN or G.F_NO_SAVING == true or G.action ~= nil
+        or not RUN_RESTORE.ready() then
+        error_response(send_response, "Checkpoint requires a settled decision state", BB_ERROR_NAMES.INVALID_STATE)
+        return
+      end
+      if BB_CHECKPOINT_STORE.count >= MAX_SNAPSHOTS then
+        error_response(send_response, "Checkpoint limit reached", BB_ERROR_NAMES.NOT_ALLOWED)
+        return
+      end
+
+      local old_run = G.FILE_HANDLER and G.FILE_HANDLER.run
+      local old_queued = G.FILE_HANDLER and G.FILE_HANDLER.update_queued
+      save_run()
+      local packed = STR_PACK(G.ARGS.save_run)
+      G.FILE_HANDLER.run = old_run
+      G.FILE_HANDLER.update_queued = old_queued
+      local snapshot_id = "s" .. tostring(BB_CHECKPOINT_STORE.next_id)
+      BB_CHECKPOINT_STORE.next_id = BB_CHECKPOINT_STORE.next_id + 1
+      BB_CHECKPOINT_STORE.entries[snapshot_id] = packed
+      BB_CHECKPOINT_STORE.count = BB_CHECKPOINT_STORE.count + 1
+      send_response({ snapshot_id = snapshot_id, bytes = #packed })
+      return
+    end
+    if args.op == "restore" then
+      local packed = BB_CHECKPOINT_STORE.entries[args.snapshot_id]
+      if not packed then
+        error_response(send_response, "Unknown checkpoint")
+        return
+      end
+      RUN_RESTORE.restore(packed, send_response, function()
+        send_response({ success = true, snapshot_id = args.snapshot_id })
+      end)
+      return
+    end
+    error_response(send_response, "Unknown checkpoint operation")
+  end,
+}
