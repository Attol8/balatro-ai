+---Extract the unordered permanent deck shown by vanilla's View Deck screen.
+---@return table[] composition
+local function extract_deck_composition()
+  local grouped = {}
+  for _, card in ipairs(G.playing_cards or {}) do
+    local value = extract_card_value(card)
+    local modifier = extract_card_modifier(card)
+    local rank = value.rank
+    local suit = value.suit
+    if modifier.enhancement == "STONE" then
+      rank = "?"
+      suit = "?"
+    end
+    if not rank or not suit then
+      error("BalatroBot cannot project permanent deck identity")
+    end
+    local permanent_bonus = value.perma_bonus or 0
+    local key = table.concat({
+      rank,
+      suit,
+      modifier.enhancement or "",
+      modifier.edition or "",
+      modifier.seal or "",
+      tostring(permanent_bonus),
+    }, "|")
+    if not grouped[key] then
+      grouped[key] = {
+        rank = rank,
+        suit = suit,
+        enhancement = modifier.enhancement,
+        edition = modifier.edition,
+        seal = modifier.seal,
+        permanent_bonus = permanent_bonus,
+        count = 0,
+      }
+    end
+    grouped[key].count = grouped[key].count + 1
+  end
+  local keys = {}
+  for key in pairs(grouped) do keys[#keys + 1] = key end
+  table.sort(keys)
+  local composition = {}
+  for _, key in ipairs(keys) do composition[#composition + 1] = grouped[key] end
+  return composition
+end
