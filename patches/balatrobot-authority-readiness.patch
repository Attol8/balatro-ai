+    def test_vanilla_mega_standard_returns_between_selections(
+        self, client: httpx.Client
+    ) -> None:
+        """The first vanilla Mega Standard pick returns while the pack stays open."""
+        load_fixture(client, "pack", "state-SHOP--packs.count-0")
