diff --git a/src/lua/utils/run_restore.lua b/src/lua/utils/run_restore.lua
new file mode 100644
--- /dev/null
+++ b/src/lua/utils/run_restore.lua
@@ -0,0 +1,86 @@
+-- Shared game-native run restore and readiness checks.
+
+local run_restore = {}
+
+local function num_items(area)
+  local count = 0
+  for _, card in ipairs((area and area.cards) or {}) do
+    if card.children and card.children.buy_button and card.children.buy_button.definition then
+      count = count + 1
+    end
+  end
+  return count
+end
+
+function run_restore.ready()
+  if not G.STATE_COMPLETE or G.CONTROLLER.locked then return false end
+  if G.CONTROLLER.locks and G.CONTROLLER.locks.load then return false end
+
+  if G.STATE == G.STATES.BLIND_SELECT then
+    return G.GAME.blind_on_deck ~= nil
+      and G.blind_select_opts ~= nil
+      and G.blind_select_opts.small ~= nil
+      and G.blind_select_opts.small:get_UIE_by_ID("tag_Small") ~= nil
+  end
+  if G.STATE == G.STATES.SELECTING_HAND then
+    return G.hand ~= nil and G.hand.cards ~= nil
+  end
+  if G.STATE == G.STATES.ROUND_EVAL and G.round_eval then
+    for _, box in ipairs(G.I.UIBOX) do
+      if box.config and box.config.major == G.round_eval
+        and box:get_UIE_by_ID("cash_out_button") then return true end
+    end
+    return false
+  end
+  if G.STATE == G.STATES.SHOP then
+    return num_items(G.shop_booster) > 0
+      or num_items(G.shop_jokers) > 0
+      or num_items(G.shop_vouchers) > 0
+  end
+  if G.STATE == G.STATES.SMODS_BOOSTER_OPENED
+    or G.STATE == G.STATES.TAROT_PACK
+    or G.STATE == G.STATES.PLANET_PACK
+    or G.STATE == G.STATES.SPECTRAL_PACK
+    or G.STATE == G.STATES.STANDARD_PACK
+    or G.STATE == G.STATES.BUFFOON_PACK then
+    return G.pack_cards and G.pack_cards.cards and #G.pack_cards.cards > 0
+  end
+  return false
+end
+
+function run_restore.restore(serialized, send_response, on_ready)
+  local ok, save_table = pcall(STR_UNPACK, serialized)
+  if not ok or type(save_table) ~= "table" then
+    send_response({ message = "Invalid saved run", name = BB_ERROR_NAMES.INTERNAL_ERROR })
+    return
+  end
+
+  G:delete_run()
+  G.SAVED_GAME = save_table
+  local original_print = print
+  print = function(message)
+    if type(message) == "string" and message:find("ERROR LOADING GAME: Card area") then return end
+    original_print(message)
+  end
+  ok, save_table = pcall(G.start_run, G, { savetext = G.SAVED_GAME })
+  print = original_print
+  if not ok then
+    send_response({
+      message = "Failed to restore saved run: " .. tostring(save_table),
+      name = BB_ERROR_NAMES.INTERNAL_ERROR,
+    })
+    return
+  end
+
+  G.E_MANAGER:add_event(Event({
+    no_delete = true,
+    trigger = "condition",
+    blocking = false,
+    func = function()
+      if run_restore.ready() then on_ready() return true end
+      return false
+    end,
+  }))
+end
+
+return run_restore
